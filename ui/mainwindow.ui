  </property>
  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">/* ============================================
   医院管理系统 - 现代简洁主题
   ============================================ */

/* 基础背景 */
QMainWindow, QWidget#centralwidget, QWidget#homePage, 
QWidget#patientsPage, QWidget#appointmentsPage {
    background-color: #F8FAFC;
}

/* ============================================
   侧边栏 - 深色对比
   ============================================ */
QWidget#sidebar {
    background-color: #1E293B;
    border-radius: 0px;
    border: none;
}

QWidget#sidebar QPushButton {
    background-color: transparent;
    border: none;
    color: #94A3B8;
    padding: 15px 20px;
    border-radius: 0px;
    text-align: left;
    font-weight: 600;
    font-size: 14px;
    margin: 2px 8px;
    border-left: 3px solid transparent;
}

QWidget#sidebar QPushButton:hover {
    background-color: #334155;
    color: #F1F5F9;
}

QWidget#sidebar QPushButton:pressed,
QWidget#sidebar QPushButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    border-left: 3px solid #60A5FA;
}

/* 侧边栏标题按钮 */
QWidget#sidebar #toggleButton {
    color: #FFFFFF;
    font-size: 18px;
    font-weight: bold;
    background-color: #0F172A;
    margin: 0;
    padding: 20px;
    border-left: none;
}

QWidget#sidebar #toggleButton:hover {
    background-color: #1E293B;
}

/* ============================================
   顶部栏
   ============================================ */
QFrame#topbar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
}

QFrame#topbar QPushButton {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    padding: 8px 12px;
    color: #64748B;
    font-weight: 500;
}

QFrame#topbar QPushButton:hover {
    background-color: #F1F5F9;
    color: #1E293B;
}

QFrame#topbar QPushButton#close:hover {
    background-color: #EF4444;
    color: #FFFFFF;
}

/* ============================================
   内容区域
   ============================================ */
QFrame#content, QStackedWidget &gt; QWidget {
    background-color: #F8FAFC;
    border: none;
}

QStackedWidget#contentStackWidget {
    background-color: #F8FAFC;
}

/* ============================================
   通用按钮样式
   ============================================ */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #3B82F6;
}

QPushButton:pressed {
    background-color: #1D4ED8;
}

QPushButton:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

/* 次要按钮 */
QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
}

QPushButton#secondaryButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

/* 危险按钮 */
QPushButton#dangerButton {
    background-color: #EF4444;
}

QPushButton#dangerButton:hover {
    background-color: #F87171;
}

/* ============================================
   输入框
   ============================================ */
QLineEdit {
    background-color: #FFFFFF;
    border: 2px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 14px;
    color: #1E293B;
    font-size: 14px;
}

QLineEdit:hover {
    border-color: #CBD5E1;
}

QLineEdit:focus {
    border-color: #2563EB;
    background-color: #FFFFFF;
}

QLineEdit::placeholder {
    color: #94A3B8;
}

/* ============================================
   表格样式
   ============================================ */
QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    color: #1E293B;
    selection-background-color: #DBEAFE;
    selection-color: #1E293B;
    alternate-background-color: #F8FAFC;
}

QTableView::item {
    padding: 12px 16px;
    border-bottom: 1px solid #F1F5F9;
}

QTableView::item:selected {
    background-color: #DBEAFE;
    color: #1E293B;
}

QTableView::item:hover {
    background-color: #F1F5F9;
}

QHeaderView::section {
    background-color: #F8FAFC;
    color: #475569;
    padding: 14px 16px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    font-weight: 700;
    font-size: 13px;
}

QHeaderView::section:hover {
    background-color: #F1F5F9;
}

/* ============================================
   标签样式
   ============================================ */
QLabel {
    color: #1E293B;
    font-size: 14px;
}

QLabel#pageTitle {
    color: #1E293B;
    font-size: 24px;
    font-weight: 700;
}

/* ============================================
   卡片容器
   ============================================ */
#homePage QFrame {
    background-color: #FFFFFF;
    border-radius: 16px;
    border: 1px solid #E2E8F0;
    padding: 20px;
}

#homePage QFrame:hover {
    border-color: #CBD5E1;
}

/* ============================================
   日历控件
   ============================================ */
QCalendarWidget QToolButton {
    color: #1E293B;
    background-color: transparent;
    border: none;
    font-size: 14px;
    font-weight: 600;
}

QCalendarWidget QToolButton:hover {
    background-color: #F1F5F9;
    border-radius: 6px;
}

QCalendarWidget QWidget#qt_calendar_navigationbar {
    background-color: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-bottom: none;
    border-radius: 12px 12px 0 0;
    padding: 8px;
}

QCalendarWidget QAbstractItemView {
    background-color: #FFFFFF;
    color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-top: none;
    border-radius: 0 0 12px 12px;
}

QCalendarWidget QAbstractItemView:disabled {
    color: #CBD5E1;
}

/* ============================================
   滚动条样式
   ============================================ */
QScrollBar:vertical {
    background-color: #F1F5F9;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #CBD5E1;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94A3B8;
}

QScrollBar::handle:vertical:pressed {
    background-color: #64748B;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #F1F5F9;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #CBD5E1;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94A3B8;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #64748B;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
</string>
