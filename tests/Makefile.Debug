####### Install

install_target: first FORCE
	@if not exist D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests mkdir D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests & if not exist D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests\$(TARGET)
	-$(INSTALL_FILE) debug\test_medical_record_widget.pdb D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests\test_medical_record_widget.pdb

uninstall_target: FORCE
	-$(DEL_FILE) D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests\$(TARGET) 
	 -$(DEL_FILE) D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests\test_medical_record_widget.pdb
	-$(DEL_DIR) D:$(INSTALL_ROOT)\software\anaconda\Library\tests\tests 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

